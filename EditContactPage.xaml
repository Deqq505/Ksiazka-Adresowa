<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ksiazka_Adresowa.EditContactPage"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Entry x:Name="nameEntryField" Placeholder="Imię i nazwisko*" />
            <Entry x:Name="emailEntryField" Placeholder="Email" Keyboard="Email" />
            <Entry x:Name="mobileEntryField" Placeholder="Telefon*" Keyboard="Telephone" />
            <Entry x:Name="addressEntryField" Placeholder="Adres" />
            
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Entry x:Name="cityEntryField" Placeholder="Miasto" Grid.Column="0" />
                <Entry x:Name="postalCodeEntryField" Placeholder="Kod pocztowy" Grid.Column="1" />
            </Grid>
            
            <Editor x:Name="notesEntryField" Placeholder="Notatki" AutoSize="TextChanges" MinimumHeightRequest="100" />
            
            <Button Text="Zapisz" Clicked="OnSaveClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>